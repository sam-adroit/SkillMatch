PGHOST=host.docker.internal
PGPORT=<PORT>
PGDATABASE=<DATABASE>
PGUSER=<USER>
PGPASSWORD=<PASSWORD>
Database__ApplyMigrations=true
Jwt__Issuer=SkillMatchBE
Jwt__Audience=SkillMatchFE
Jwt__Key=<GENERATE-A-RANDOM-SECRET-OF-AT-LEAST-32-BYTES>
Jwt__ExpiresMinutes=60
DemoSeed__Enabled=true
DemoSeed__AdminEmail=admin@skillmatch.local
DemoSeed__AdminPassword=<CHOOSE-A-DEMO-PASSWORD-OF-AT-LEAST-12-CHARACTERS>
OPENAI_API_KEY=<OPENAI-PROJECT-KEY>
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=15
