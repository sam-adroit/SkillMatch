        Project[ProjectTopic<br/>&lt;&lt;entity&gt;&gt;]
        History[RecommendationHistory<br/>&lt;&lt;entity&gt;&gt;]
    end
    OpenAI[OpenAI Responses API<br/>&lt;&lt;external system&gt;&gt;]

    Actor --> RecPage --> RecController --> RecService
    RecService --> RecRepo
